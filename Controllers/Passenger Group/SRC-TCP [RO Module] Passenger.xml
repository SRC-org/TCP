			<c type="56">
				<object id="345" script="gN=input.getNumber;gB=input.getBool;sN=output.setNumber;sB=output.setBool;
function onTick()


	-- bools
	
	-- doors
	sB(4,gB(1)) -- left
	sB(5,gB(2)) -- right
	sB(6,gB(3)) -- open
	
	-- heater
	sB(7,gB(25))
	
	
	-- numbers
	
	-- doors
	sN(4,dec(4, 6)) -- first
	sN(5,dec(10,6)) -- last
	
	-- lighting
	sN(6,dec(16,3)/7+dec(26,2)/21) -- r
	sN(7,dec(19,3)/7+dec(28,2)/21) -- g
	sN(8,dec(22,3)/7+dec(30,2)/21) -- b


end

-- decode an integer from channel c with b bits
-- the first bit is the lsb
function dec(c,b)
	n = 0
	for i=1,b do
		n = n*2
		n = n+(gB(c+b-i) and 1 or 0)
	end
	return n
end">
